<paf_config>
    <param name="HARNESS_TIMEOUT_SEC" value="90"/>

    <phase name="workspace_check">
        <task name="paf_workspace.domains.xen_zephyr.tasks.base.check_workspace_environment"/>
    </phase>

    <phase name="prepare">
        <task name="paf_workspace.domains.xen_zephyr.tasks.base.check_workspace_environment"/>
        <task name="paf_workspace.domains.environments.tasks.zephyr_xen.ensure_environment_image"/>
        <task name="paf_workspace.domains.environments.tasks.zephyr_xen.check_zephyr_xen_tools"/>
    </phase>

    <phase name="build">
        <task name="paf_workspace.domains.xen_zephyr.tasks.build.build_product"/>
        <task name="paf_workspace.domains.xen_zephyr.tasks.build.write_artifact_manifest"/>
    </phase>

    <phase name="harness_scenario">
        <task name="paf_workspace.domains.xen_zephyr.tasks.harness.load_harness_scenario"/>
    </phase>

    <phase name="harness_prepare">
        <task name="paf_workspace.domains.xen_zephyr.tasks.harness.prepare_harness_inputs"/>
    </phase>

    <phase name="harness_run">
        <task name="paf_workspace.domains.xen_zephyr.tasks.harness.run_harness_command"/>
    </phase>

    <phase name="validate">
        <task name="paf_workspace.domains.xen_zephyr.tasks.harness.validate_runtime_log"/>
    </phase>

    <phase name="push_guard">
        <task name="paf_workspace.tasks.record_push_guard_success"/>
    </phase>

    <scenario name="default">
        <phase name="prepare"/>
        <phase name="build"/>
        <phase name="harness_scenario"/>
        <phase name="harness_prepare"/>
        <phase name="harness_run"/>
        <phase name="validate"/>
        <phase name="push_guard"/>
    </scenario>

    <scenario name="run-only">
        <phase name="prepare"/>
        <phase name="harness_scenario"/>
        <phase name="harness_prepare"/>
        <phase name="harness_run"/>
        <phase name="validate"/>
    </scenario>

    <scenario name="build-only">
        <phase name="prepare"/>
        <phase name="build"/>
        <phase name="push_guard"/>
    </scenario>

    <scenario name="harness-check">
        <phase name="workspace_check"/>
        <phase name="harness_scenario"/>
    </scenario>

    <scenario name="check-only">
        <phase name="workspace_check"/>
    </scenario>
</paf_config>
