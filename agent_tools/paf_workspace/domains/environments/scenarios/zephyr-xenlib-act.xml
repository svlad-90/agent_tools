<paf_config>
    <phase name="ensure">
        <task name="paf_workspace.domains.environments.tasks.act.ensure_zephyr_xenlib_act_image"/>
    </phase>

    <phase name="image_check">
        <task name="paf_workspace.domains.environments.tasks.act.check_zephyr_xenlib_act_image"/>
    </phase>

    <phase name="check">
        <task name="paf_workspace.domains.environments.tasks.act.check_zephyr_xenlib_act_tools"/>
    </phase>

    <phase name="validate">
        <task name="paf_workspace.domains.environments.tasks.act.validate_zephyr_xenlib_act"/>
    </phase>

    <phase name="push_guard">
        <task name="paf_workspace.tasks.record_push_guard_success"/>
    </phase>

    <phase name="run_container_command">
        <task name="paf_workspace.domains.environments.tasks.base.run_container_command"/>
    </phase>

    <scenario name="check-only">
        <phase name="image_check"/>
        <phase name="check"/>
    </scenario>

    <scenario name="validate">
        <phase name="ensure"/>
        <phase name="validate"/>
        <phase name="push_guard"/>
    </scenario>

    <scenario name="run-container-command">
        <phase name="ensure"/>
        <phase name="run_container_command"/>
    </scenario>
</paf_config>
