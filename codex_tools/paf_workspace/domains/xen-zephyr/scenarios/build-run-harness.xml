<paf_config>
    <param name="ENV_CHECK_CMD" value="codex_tools/environments/zephyr-xen/scripts/check.sh"/>
    <param name="ENV_BUILD_CMD" value="codex_tools/environments/zephyr-xen/scripts/build.sh"/>
    <param name="HARNESS_TIMEOUT_SEC" value="90"/>

    <phase name="workspace_check">
        <task name="paf_workspace.tasks.check_workspace_environment"/>
    </phase>

    <phase name="prepare">
        <task name="paf_workspace.tasks.check_workspace_environment"/>
        <task name="paf_workspace.tasks.ensure_runtime_environment"/>
    </phase>

    <phase name="build">
        <task name="paf_workspace.tasks.build_product"/>
        <task name="paf_workspace.tasks.write_artifact_manifest"/>
    </phase>

    <phase name="run">
        <task name="paf_workspace.tasks.run_xen_harness_scenario"/>
    </phase>

    <scenario name="default">
        <phase name="prepare"/>
        <phase name="build"/>
        <phase name="run"/>
    </scenario>

    <scenario name="run-only">
        <phase name="prepare"/>
        <phase name="run"/>
    </scenario>

    <scenario name="build-only">
        <phase name="prepare"/>
        <phase name="build"/>
    </scenario>

    <scenario name="check-only">
        <phase name="workspace_check"/>
    </scenario>
</paf_config>
